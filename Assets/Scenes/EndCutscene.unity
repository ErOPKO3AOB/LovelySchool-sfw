  text: 
  ru: "\u0410\u0412\u0422\u041E\u0411\u0423\u0421 \u041F\u0415\u0420\u0415\u0425\u0412\u0410\u0427\u0415\u041D,
    \u041F\u041E\u0411\u0415\u0414\u0410!!!"
  en: BUS INTERCEPTED, VICTORY!!!
  tr: "OTOB\xDCS DURDURULDU, ZAFER!!!"
  az: 
  be: "\u0410\u040E\u0422\u041E\u0411\u0423\u0421 \u043F\u0435\u0440\u0430\u0445\u043E\u043F\u043B\u0435\u043D\u044B,
    \u041F\u0415\u0420\u0410\u041C\u041E\u0413\u0410!!!"
  he: 
  hy: 
  ka: 
  et: 
  fr: 
  kk: "\u0410\u0412\u0422\u041E\u0411\u0423\u0421 \u041A\u0415\u041B\u0414\u0406,
    \u0416\u0415\u04A2\u0406\u0421!!!"
  ky: 
  lt: 
  lv: 
  ro: 
  tg: 
  tk: 
  uk: "\u0410\u0412\u0422\u041E\u0411\u0423\u0421 \u043F\u0435\u0440\u0435\u0445\u043E\u043F\u043B\u0435\u043D\u0438\u0439,
    \u041F\u0415\u0420\u0415\u041C\u041E\u0413\u0410!"
  uz: AVTOBUS TO'SIB OLDI, G'alaba!!!
  es: 
  pt: 
  ar: 
  id: 
  ja: 
  it: 
  de: 
  hi: "\u092C\u0938 \u0930\u094B\u0915\u0940 \u0917\u0908, \u091C\u0940\u0924!!!"
