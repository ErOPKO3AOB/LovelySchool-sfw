  m_text: "Lovely School\n\n\n\n\n\n\n\n\n\u0421\u0434\u0435\u043B\u0430\u043D\u043E
    \u0433\u0434\u0435-\u0442\u043E \u0437\u0430 \u0434\u0432\u0435 \u043D\u0435\u0434\u0435\u043B\u0438
    \u043F\u0440\u0438 \u043F\u043E\u043C\u043E\u0449\u0438 \u0440\u0443\u043A, \u0430
    \u0442\u0430\u043A\u0436\u0435 \u043E\u043F\u0442\u0438\u043C\u0438\u0437\u0430\u0446\u0438\u0438
    \u0442\u0440\u0443\u0434\u0430 \u0437\u0430 \u0441\u0447\u0435\u0442 \u0434\u0438\u043F\u0441\u0438\u043A\u0430
    \u043C\u0435\u0441\u0442\u0430\u043C\u0438 (\u043E\u0434\u043D\u0430\u043A\u043E
    \u043D\u0435 \u0432\u0435\u0437\u0434\u0435 \u043F\u0440\u043E\u043A\u0430\u0442\u0438\u043B\u043E
    \u0441 \u0432\u0430\u0439\u0431\u043A\u043E\u0434\u0438\u043D\u0433\u043E\u043C
    \U0001F601)\n\n\n\n\n\n\n\n\u041C\u0443\u0437\u044B\u0447\u043A\u0430 \u0447\u0435\u0442\u043E
    \u0438\u0437 \u0443\u043B\u044C\u0442\u0440\u0430\u043A\u0438\u043B\u043B\u0430,
    \u0447\u0435\u0442\u043E \u0430\u0439\u0442\u0438\u0448\u0430\u043D\u0441\u043E\u043D
    \u0440\u0435\u043C\u0438\u0445\n\n\n\n\n\n\n\u041C\u0430\u0442\u0432\u0438\u0439,
    \u0421 \u0414\u041D\u0415\u041C \u0420\u041E\u0416\u0414\u0415\u041D\u0418\u042F!!"
