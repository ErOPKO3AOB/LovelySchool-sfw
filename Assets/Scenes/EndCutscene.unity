  text: 
  ru: "\u041D\u0430\u0436\u043C\u0438, \u0447\u0442\u043E\u0431 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
  en: Click to skip
  tr: "Atlamak i\xE7in t\u0131klay\u0131n"
  az: 
  be: "\u041D\u0430\u0446\u0456\u0441\u043D\u0456, \u043A\u0430\u0431 \u043F\u0440\u0430\u043F\u0443\u0441\u0446\u0456\u0446\u044C"
  he: 
  hy: 
  ka: 
  et: 
  fr: 
  kk: "\u04E8\u0442\u043A\u0456\u0437\u0456\u043F \u0436\u0456\u0431\u0435\u0440\u0443
    \u04AF\u0448\u0456\u043D \u0431\u0430\u0441\u044B\u04A3\u044B\u0437"
  ky: 
  lt: 
  lv: 
  ro: 
  tg: 
  tk: 
  uk: "\u041D\u0430\u0442\u0438\u0441\u043D\u0438, \u0449\u043E\u0431 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0438"
  uz: "O\u02BBtkazib yuborish uchun bosing"
  es: 
  pt: 
  ar: 
  id: 
  ja: 
  it: 
  de: 
  hi: "\u091B\u094B\u0921\u093C\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F \u0915\u094D\u0932\u093F\u0915
    \u0915\u0930\u0947\u0902"
